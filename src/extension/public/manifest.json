{
  "manifest_version": 3,
  "name": "Nimbus Tab DVR",
  "version": "0.0.1",
  "description": "Records the tab a host application asks it to, with chrome.tabCapture and MediaRecorder.",
  "key": "",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Nimbus Tab DVR: click once to allow capture of this tab"
  },
  "commands": {
    "invoke": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Allow capture of the current tab"
    }
  },
  "storage": {
    "managed_schema": "managed-schema.json"
  }
}
