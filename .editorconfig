# EditorConfig helps maintain consistent coding styles across editors.
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,md,markdown}]
indent_size = 2

# A markdown hard break is two trailing spaces, so trimming them changes the text.
[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
