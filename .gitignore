# Build products. Everything a script writes goes under one of these, so `clean`
# is a directory removal and a stray artifact is visible in `git status`.
dist/
build/
.build/
.build-*/

# Local, uncommitted machine configuration read by the scripts.
.env
.signing

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Agent state and the worktrees other sessions create here.
.claude/

# Node
node_modules/

# The demo pages build.sh copies into the Go module for go:embed; .gitkeep holds the directory.
backend/static/*
!backend/static/.gitkeep

# Playwright
test-results/
playwright-report/

# Signing keys never enter the repository; the public half is in the manifest.
*.pem
.build-chrome/
